# ─────────────────────────────────────────────────────────────────────────────
# OrigamiNav — .gitignore
#
# Rule of thumb: anything generated by a build, an install, an editor or a
# running instance stays out of the repo. The only tracked dotenv file is
# `.env.example`; every real `.env` may hold a production DATABASE_URL.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Next.js build output ────────────────────────────────────────────────────
.next/
out/
build/
dist/
.swc/
next-env.d.ts

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
*.d.ts.map

# ─── Environment files — never commit ────────────────────────────────────────
# A committed DATABASE_URL is a committed database password.
.env
.env.*
!.env.example
.env.local
.env.*.local

# ─── Local database / backups ────────────────────────────────────────────────
# `npm run db:studio` dumps and manual pg_dump backups can contain every
# bookmark, admin row and password hash.
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.sql.gz
backups/
drizzle/meta/_journal.json.bak

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ─── Test / coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
playwright-report/
test-results/

# ─── Editors & IDEs ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─── AI coding assistants (local, machine-specific) ──────────────────────────
.claude/
.cursor/
.aider*
.continue/
.codeium/
.windsurf/

# ─── Operating systems ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Secrets & certificates ──────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.crt
!*.example.pem

# ─── Local packaging leftovers ───────────────────────────────────────────────
# Hand-built bundles and their checksums stay out of the repo.
stage/
*.tar.gz
*.tar.gz.sha256

# ─── Deploy platform cruft ───────────────────────────────────────────────────
.vercel
.netlify
.turbo
.eslintcache
.cache/
