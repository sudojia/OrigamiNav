{
  "name": "origaminav",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted, open-source bookmark navigation site. Two-level categories, pinyin search, three theme skins, and a built-in admin — backed by nothing but a standard Postgres connection string.",
  "license": "MIT",
  "author": "OrigamiNav contributors",
  "keywords": [
    "bookmark",
    "bookmarks",
    "navigation",
    "start-page",
    "self-hosted",
    "nextjs",
    "drizzle-orm",
    "pinyin"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "iron-session": "^9.0.1",
    "lucide-react": "^0.545.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "pinyin-pro": "^3.29.4",
    "puppeteer-core": "^24.43.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "undici": "^7.30.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.9",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
